local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

local TARGET_MODEL_NAME = "meteor"
local SPEED_STUDS_PER_SEC = 55
local WAIT_TIME_AT_TARGET = 5

local activeESP = {}
local isBusy = false
local visitedMeteors = {}

local autoTweenEnabled = false
local currentTween = nil

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MeteorNotifierGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local notifyButton = Instance.new("TextButton")
notifyButton.Name = "NotifyButton"
notifyButton.Size = UDim2.new(0, 200, 0, 50)
notifyButton.Position = UDim2.new(0.5, -100, 0.15, 0)
notifyButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
notifyButton.BackgroundTransparency = 0.2
notifyButton.BorderSizePixel = 0
notifyButton.TextColor3 = Color3.fromRGB(255, 70, 70)
notifyButton.TextStrokeTransparency = 0.5
notifyButton.Font = Enum.Font.SourceSansBold
notifyButton.TextSize = 18
notifyButton.Text = "Auto-Tween: OFF [E]"
notifyButton.Active = true
notifyButton.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = notifyButton

local uiStroke = Instance.new("UIStroke")
uiStroke.Color = Color3.fromRGB(255, 255, 255)
uiStroke.Thickness = 1.5
uiStroke.Parent = notifyButton

local function updateNotification()
    if autoTweenEnabled then
        notifyButton.Text = "Auto-Tween: ON [E]"
        notifyButton.TextColor3 = Color3.fromRGB(85, 255, 127)
    else
        notifyButton.Text = "Auto-Tween: OFF [E]"
        notifyButton.TextColor3 = Color3.fromRGB(255, 70, 70)
    end
end

local function stopCurrentTween()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    isBusy = false
end

local function toggleAutoTween()
    autoTweenEnabled = not autoTweenEnabled
    updateNotification()

    if not autoTweenEnabled then
        stopCurrentTween()
    end
end

notifyButton.MouseButton1Click:Connect(function()
    toggleAutoTween()
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.E then
        toggleAutoTween()
    end
end)

local function findPrimaryPart(instance)
    if instance:IsA("Model") and instance.PrimaryPart then
        return instance.PrimaryPart
    end
    return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function applyESP(target)
    if activeESP[target] then return end

    local primaryPart = findPrimaryPart(target)
    if not primaryPart then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "MeteorESP_Highlight"
    highlight.Adornee = target
    highlight.FillColor = Color3.fromRGB(255, 50, 50)
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.Parent = target

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MeteorESP_Billboard"
    billboard.Adornee = primaryPart
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextSize = 16
    textLabel.Text = target.Name .. " [...]"
    textLabel.Parent = billboard

    billboard.Parent = target

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not target:IsDescendantOf(Workspace) then
            highlight:Destroy()
            billboard:Destroy()
            connection:Disconnect()
            activeESP[target] = nil
            return
        end

        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local dist = math.floor((char.HumanoidRootPart.Position - primaryPart.Position).Magnitude)
            textLabel.Text = string.format("%s [%d studs]", target.Name, dist)
        end
    end)

    activeESP[target] = connection
end

local function triggerProximityPrompt(target)
    local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then return end

    if fireproximityprompt then
        fireproximityprompt(prompt)
    else
        task.spawn(function()
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration or 0.5)
            prompt:InputHoldEnd()
        end)
    end
end

local function processMeteor(target)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local primaryPart = findPrimaryPart(target)
    if not primaryPart then return end

    isBusy = true

    local targetCFrame = primaryPart.CFrame * CFrame.new(9, 10, 0)
    local targetPosition = targetCFrame.Position

    local distance = (hrp.Position - targetPosition).Magnitude
    local travelTime = distance / SPEED_STUDS_PER_SEC

    local tweenInfo = TweenInfo.new(
        travelTime,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()

    local completed = false
    local connection
    connection = currentTween.Completed:Connect(function()
        completed = true
        if connection then connection:Disconnect() end
    end)

    while not completed and autoTweenEnabled do
        task.wait(0.1)
    end

    if not autoTweenEnabled then
        stopCurrentTween()
        return
    end

    local waitTimer = 0
    while waitTimer < WAIT_TIME_AT_TARGET and autoTweenEnabled do
        triggerProximityPrompt(target)
        task.wait(0.5)
        waitTimer = waitTimer + 0.5
    end

    if autoTweenEnabled then
        if target:IsDescendantOf(Workspace) then
            visitedMeteors[target] = true
        end
    end

    isBusy = false
end

local function getNextMeteor()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart

    local unvisitedCount = 0
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if string.lower(descendant.Name) == TARGET_MODEL_NAME and descendant:IsDescendantOf(Workspace) and not visitedMeteors[descendant] then
            unvisitedCount = unvisitedCount + 1
        end
    end

    if unvisitedCount == 0 then
        table.clear(visitedMeteors)
    end

    local closest = nil
    local shortestDistance = math.huge

    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if string.lower(descendant.Name) == TARGET_MODEL_NAME and descendant:IsDescendantOf(Workspace) and not visitedMeteors[descendant] then
            local primaryPart = findPrimaryPart(descendant)
            if primaryPart then
                local dist = (hrp.Position - primaryPart.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closest = descendant
                end
            end
        end
    end

    return closest
end

task.spawn(function()
    while true do
        for _, descendant in ipairs(Workspace:GetDescendants()) do
            if string.lower(descendant.Name) == TARGET_MODEL_NAME then
                applyESP(descendant)
            end
        end

        if autoTweenEnabled and not isBusy then
            local nextTarget = getNextMeteor()
            if nextTarget then
                processMeteor(nextTarget)
            end
        end

        task.wait(0.5)
    end
end)
