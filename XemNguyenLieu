local Player = game.Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Smart_X18_Scanner"
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(0, 350, 0, 45)
statusLabel.Position = UDim2.new(0.5, -175, 0.05, 0)
statusLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
statusLabel.BackgroundTransparency = 0.6
statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
statusLabel.TextScaled = true
statusLabel.Font = Enum.Font.GothamBold
statusLabel.Text = "Waiting for Spawn..."
statusLabel.Parent = screenGui

local targetNames = {
    "X-18", 
    "Memory Piece", 
    "Professor's Monitor", 
    "Broken Tracking Device"
}

local function scanWorkspace()
    local foundList = {}
    
    for _, v in pairs(workspace:GetChildren()) do
        local isTarget = false
        local matchedName = ""

        for _, target in pairs(targetNames) do
            if string.sub(v.Name, 1, string.len(target)) == target then
                isTarget = true
                matchedName = v.Name
                break
            end
        end

        if isTarget then
            if not table.find(foundList, matchedName) then
                table.insert(foundList, matchedName)
            end
            
            if not v:FindFirstChild("ItemHighlight") then
                local highlight = Instance.new("Highlight")
                highlight.Name = "ItemHighlight"
                highlight.FillColor = Color3.fromRGB(0, 255, 0)
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = v
            end
        end
    end
    return foundList
end

task.spawn(function()
    while task.wait(0.5) do
        local items = scanWorkspace()
        if #items > 0 then
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            statusLabel.Text = "FOUND: " .. table.concat(items, " | ")
        else
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            statusLabel.Text = "Vat pham chua spawn..."
        end
    end
end)
