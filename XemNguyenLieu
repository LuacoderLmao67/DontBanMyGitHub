local Player = game.Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Smart_X18_Scanner"
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

local statusLabel = Instance.new("TextLabel")
-- Tăng kích thước rộng ra (400) và cao hơn (200) để chứa được nhiều dòng
statusLabel.Size = UDim2.new(0, 400, 0, 200)
statusLabel.Position = UDim2.new(1, -410, 0.02, 0)
statusLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
statusLabel.BackgroundTransparency = 0.6
statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
statusLabel.TextSize = 18 -- Cố định cỡ chữ để không bị quá to/nhỏ
statusLabel.Font = Enum.Font.GothamBold
statusLabel.TextXAlignment = Enum.TextXAlignment.Left -- Căn lề trái cho giống danh sách
statusLabel.TextYAlignment = Enum.TextYAlignment.Top -- Đẩy chữ lên trên cùng
statusLabel.TextWrapped = true -- Tự động xuống dòng nếu tên quá dài
statusLabel.Text = "Waiting for Spawn..."
statusLabel.Parent = screenGui

local keywords = {"x-18", "memo", "prof", "moni", "brok"}

local function scan()
    local found = {}
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Part") and v.ClassName == "Part" then 
            continue 
        end

        local nameLower = string.lower(v.Name)
        for _, key in pairs(keywords) do
            if string.find(nameLower, key) then
                if not table.find(found, v.Name) then 
                    table.insert(found, v.Name) 
                end
                if not v:FindFirstChild("ItemHighlight") then
                    local h = Instance.new("Highlight")
                    h.Name = "ItemHighlight"
                    h.FillColor = Color3.fromRGB(0, 255, 0)
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = v
                end
                break
            end
        end
    end
    return found
end

task.spawn(function()
    while task.wait(0.5) do
        local items = scan()
        if #items > 0 then
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            -- Tạo danh sách theo dòng: Line 1: Tên đồ
            local displayText = ""
            for i, name in ipairs(items) do
                displayText = displayText .. "Line " .. i .. ": " .. name .. "\n"
            end
            statusLabel.Text = displayText
        else
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            statusLabel.Text = "Vat pham chua spawn..."
        end
    end
end)
