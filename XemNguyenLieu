local Player = game.Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Smart_X18_Scanner"
screenGui.ResetOnSpawn = false
screenGui.Parent = PlayerGui

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(0, 300, 0, 40)
statusLabel.Position = UDim2.new(1, -310, 0.02, 0)
statusLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
statusLabel.BackgroundTransparency = 0.6
statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
statusLabel.TextScaled = true
statusLabel.Font = Enum.Font.GothamBold
statusLabel.TextXAlignment = Enum.TextXAlignment.Right
statusLabel.Text = "Waiting for Spawn..."
statusLabel.Parent = screenGui

local keywords = {"x-18", "memo", "prof", "moni", "brok"}

local function scan()
    local found = {}
    for _, v in pairs(workspace:GetChildren()) do
        local nameLower = string.lower(v.Name)
        for _, key in pairs(keywords) do
            if string.find(nameLower, key) then
                if not table.find(found, v.Name) then table.insert(found, v.Name) end
                if not v:FindFirstChild("ItemHighlight") then
                    local h = Instance.new("Highlight")
                    h.Name = "ItemHighlight"
                    h.FillColor = Color3.fromRGB(0, 255, 0)
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = v
                end
                break
            end
        end
    end
    return found
end

task.spawn(function()
    while task.wait(0.5) do
        local items = scan()
        if #items > 0 then
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            statusLabel.Text = "FOUND: " .. table.concat(items, " | ")
        else
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            statusLabel.Text = "Vat pham chua spawn..."
        end
    end
end)
